# NoteNest Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# Optional: Cloudflare R2 / S3 High-Capacity Storage (10 GB Free Forever)
# If left blank, NoteNest automatically defaults to Supabase Cloud Storage (1 GB)
VITE_R2_ACCOUNT_ID=
VITE_R2_ACCESS_KEY_ID=
VITE_R2_SECRET_ACCESS_KEY=
VITE_R2_BUCKET_NAME=notenest-files
VITE_R2_PUBLIC_DOMAIN=
